# MySQL connection string
MYSQL_URI=mysql://<db_username>:<db_password>@<host>:<port>/tms

# JWT secret for backend token signing
JWT_SECRET=change-this-secret

# Google OAuth client ID for token audience validation
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# Optional email settings for reminders
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=task-management-system@example.com

# Firebase Admin SDK configuration for verifying Firebase ID tokens
# Option 1: load the service account JSON file directly
# FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/management-system-45a51-firebase-adminsdk-fbsvc-ec05178c14.json
# Option 2: provide the credential fields directly
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
