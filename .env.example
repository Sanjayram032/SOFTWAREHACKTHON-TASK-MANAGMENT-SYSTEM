PORT=5000
# MongoDB (used by server.js if you want persistent storage)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/tms?retryWrites=true&w=majority

# JWT secret used by the backend
JWT_SECRET=change-this-secret

# Google OAuth client IDs
# Frontend: Vite will expose variables prefixed with VITE_
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
# Backend verification (optional but recommended)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# Email settings (optional - for reminders)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=task-management-system@example.com
